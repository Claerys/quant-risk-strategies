# Copy to .env (git-ignored) and fill in. Nothing here is required to run the project.

# Telegram alerts from the paper-trading cycle: create a bot with @BotFather, message it once,
# then read your chat id from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Interactive Brokers (paper only). IB Gateway or TWS must be running with the API socket enabled.
# The socket needs no username or password: the login lives in Gateway itself.
# Paper ports: 4002 (IB Gateway), 7497 (TWS). Live ports 4001 and 7496 are refused.
IBKR_HOST=127.0.0.1
IBKR_PORT=4002
IBKR_CLIENT_ID=1
IBKR_REQUEST_TIMEOUT=60
# Your paper account id (starts with DU). Needed only to send orders, not to download data.
IBKR_ACCOUNT=
